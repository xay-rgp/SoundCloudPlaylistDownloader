#!/bin/sh
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"

for dependency in python3 yt-dlp ffmpeg ffprobe; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        printf 'Missing required command: %s\n' "$dependency" >&2
        printf 'Install Python 3, yt-dlp, and FFmpeg, then launch the AppImage again.\n' >&2
        exit 127
    fi
done

if ! python3 -c 'import gi; gi.require_version("Gtk", "3.0")' 2>/dev/null; then
    printf 'Install Python GObject and GTK 3 (python3-gi and gir1.2-gtk-3.0 on Debian/Ubuntu).\n' >&2
    exit 127
fi

exec python3 "$APPDIR/usr/share/soundcloud-playlist-downloader/app.py"
